# Copy to .env.local. Nothing here is public — there is no NEXT_PUBLIC_* variable
# in this app on purpose, because a Firebase credential must never be compiled
# into a browser bundle. See src/lib/firestore.ts.

# Comma-separated organizer emails. About ten people; an env var is the right
# amount of engineering (DECISIONS.md #5). Removing an address here also kills
# any live session that address holds.
CONSOLE_ALLOWLIST=organizer@knowledgegraph.tech

# Signs the session cookie. Any random string of 16+ characters; changing it
# signs everyone out. Generate with: openssl rand -base64 32
CONSOLE_SESSION_SECRET=change-me-openssl-rand-base64-32

# Set → the local emulator, no credentials needed. Unset → the real project,
# and then GOOGLE_APPLICATION_CREDENTIALS is mandatory. Exactly the rule
# scripts/src/lib/firestore.ts uses, so the two cannot drift.
FIRESTORE_EMULATOR_HOST=localhost:8080
GCLOUD_PROJECT=kgc-database

# Only when FIRESTORE_EMULATOR_HOST is unset. Do not do this yet: the console
# has no MFA, and the Admin SDK bypasses firestore.rules entirely.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
