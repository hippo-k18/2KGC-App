# Local development. Gitignored — never commit this file.
# Generated 2026-08-25. Regenerate the two secrets with: openssl rand -base64 32

# --- Firestore ------------------------------------------------------------
# Set → the local emulator, no credentials needed. Unset → the real project,
# and then GOOGLE_APPLICATION_CREDENTIALS becomes mandatory.
FIRESTORE_EMULATOR_HOST=localhost:8080
GCLOUD_PROJECT=kgc-conference-app-and-website

# --- Who may sign in ------------------------------------------------------
# Comma-separated. Bare usernames are allowed so a demo needs no mailbox.
CONSOLE_ALLOWLIST=demo,hartigandeely456@gmail.com

# --- Sign-in secrets ------------------------------------------------------
# Signs the session cookie. Machine value — never typed by a human.
CONSOLE_SESSION_SECRET=change-me-openssl-rand-base64-32

# The password you type on the login screen, alongside your email.
# Must be 12+ characters once this process can reach the real project.
CONSOLE_PASSPHRASE=change-me-12-chars-minimum

# --- Stripe (optional) ----------------------------------------------------
# Only needed to issue refunds and read discount codes from this dashboard.
# Use the SAME key as apps/web, or the two disagree about test vs live.
# STRIPE_SECRET_KEY=sk_test_...

# --- Email (optional) -----------------------------------------------------
# Needed for Message Speakers / Message Sponsors and for the confirmation
# emails sent when an invoice is marked paid out of band.
# RESEND_API_KEY=re_...
# EMAIL_FROM=KGC 2027 <tickets@knowledgegraph.tech>

# --- Confirmation links ---------------------------------------------------
# MUST be byte-identical to WEB_ORDER_SECRET in apps/web/.env.local. The
# dashboard mints /order/{token} links when it marks an invoice paid, and the
# website verifies them — two different secrets means every such link 404s.
WEB_ORDER_SECRET=must-match-apps-web-exactly

# Where those links point. Defaults to the production site.
# WEB_PUBLIC_ORIGIN=http://localhost:3200

# --- Demo mode ------------------------------------------------------------
# `1` prints the sign-in email and passphrase in a panel inside the login card,
# under the fields, so a presenter does not have to remember them. That is a
# full bypass of the only gate in front of an Admin SDK — acceptable only while
# the data behind it is the synthetic seed. Remove it before anything real.
# DEMO_MODE=1

# --- Gap notes ------------------------------------------------------------
# `1` shows the dashboard's notes about itself: the "Not built here" panel on
# 126 screens, the eight full gap cards, the grey "not built" header tags, and
# the sign-in security banner. They are accurate and they are written for
# whoever is building this — an audience reads them as a verdict on the product,
# so they are off unless asked for. See src/lib/gap-notes.ts.
# SHOW_GAP_NOTES=1
