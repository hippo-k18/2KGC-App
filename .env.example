# Copy to .env.local and fill in from the Firebase console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup and config
#
# EXPO_PUBLIC_ variables are embedded in the app bundle. That is expected for
# Firebase; security comes from firestore.rules, not from hiding these.
#
# After changing any of these, restart with a cleared cache: npx expo start -c

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
