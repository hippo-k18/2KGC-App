# Copy to .env.local and fill in. .env.local is gitignored.

# --- Firebase web app config (Project settings > General > Your apps) ---
# NEXT_PUBLIC_* values are embedded in the client bundle. That is expected for
# Firebase web config; access control comes from firestore.rules, not secrecy.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web Push certificate key pair (Project settings > Cloud Messaging).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase Admin SDK (Project settings > Service accounts) ---
# Secret. Never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full key on one line, keeping the literal \n escapes, in quotes:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
