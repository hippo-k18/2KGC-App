# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# env files — every variant is ignored except the committed template
.env*
!.env.example

# firebase
.firebase/
firebase-debug.log*
firestore-debug.log*
serviceAccountKey.json

# typescript
*.tsbuildinfo

# Cloud Functions build output — esbuild regenerates this from functions/src;
