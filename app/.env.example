# Copy to .env.local and fill in from the Firebase console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup and config
#
# EXPO_PUBLIC_ variables are embedded in the app bundle. That is expected for
# Firebase; security comes from firestore.rules, not from hiding these.
#
# After changing any of these, restart with a cleared cache: npx expo start -c

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Local development against the Firestore emulator.
# Set to 1 and run:  npx firebase emulators:start --only firestore
# then:              npm run seed
# On a physical device set EXPO_PUBLIC_EMULATOR_HOST to your Mac's LAN IP —
# "localhost" on a phone means the phone.
EXPO_PUBLIC_USE_EMULATOR=0
EXPO_PUBLIC_EMULATOR_HOST=localhost

# An HTTPS reverse tunnel per emulator, for reaching a laptop's emulators from a
# device that is not on this wifi. They override EXPO_PUBLIC_EMULATOR_HOST, and
# each needs its own value because a quick tunnel maps one port, so Auth and
# Firestore land on unrelated hostnames.
EXPO_PUBLIC_EMULATOR_AUTH_URL=
EXPO_PUBLIC_EMULATOR_FIRESTORE_URL=


# Where the app finds the marketing site.
#
# Two things need it. Sign-in is served there — /api/auth/request-code and
# /api/auth/verify-code on apps/web — rather than by a Cloud Function, because
# deploying functions on this project needs an IAM grant only the owner can give
# (OWNER-ACTIONS.md §3). And "Add to My Calendar" on a session hands out
# /agenda/{id}/calendar.ics from the same host. The default in code is the
# deployed site, so a build with no .env.local does both.
#
# Point it at http://localhost:3200 to run the whole demo locally. On a physical
# device that has to be your Mac's LAN IP, for the same reason
# EXPO_PUBLIC_EMULATOR_HOST does: "localhost" on a phone means the phone.
#
# Corrected from kgc-2027-website.netlify.app, which is an abandoned deploy on a
# different Netlify account — the same wrong value src/lib/auth/otp.ts carried
# until 2026-09-14.
EXPO_PUBLIC_SITE_ORIGIN=https://kgc27-website.netlify.app
