# Copy to .env.local and fill in from the Firebase console:
#   Project settings -> General -> Your apps -> Web app -> SDK setup and config
#
# EXPO_PUBLIC_ variables are embedded in the app bundle. That is expected for
# Firebase; security comes from firestore.rules, not from hiding these.
#
# After changing any of these, restart with a cleared cache: npx expo start -c

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Local development against the Firestore emulator.
# Set to 1 and run:  npx firebase emulators:start --only firestore
# then:              npm run seed
# On a physical device set EXPO_PUBLIC_EMULATOR_HOST to your Mac's LAN IP —
# "localhost" on a phone means the phone.
EXPO_PUBLIC_USE_EMULATOR=0
EXPO_PUBLIC_EMULATOR_HOST=localhost

# Demoing to someone not on this wifi: `npm run demo:public` opens an HTTPS
# tunnel per emulator and fills these in for you. They override
# EXPO_PUBLIC_EMULATOR_HOST, and each needs its own value because a quick tunnel
# maps one port, so Auth and Firestore land on unrelated hostnames.
EXPO_PUBLIC_EMULATOR_AUTH_URL=
EXPO_PUBLIC_EMULATOR_FIRESTORE_URL=

# Any email + any password (or neither) signs in as the seeded demo attendee.
# For audience demos only. Emulator-gated three ways — read the OPEN_SIGNIN
# docblock in src/app/login.tsx before turning this on.
EXPO_PUBLIC_OPEN_SIGNIN=0
