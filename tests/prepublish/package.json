{
  "name": "@kgc/prepublish-tests",
  "private": true,
  "description": "The gate every website publish passes through. Playwright against a draft deploy (or any origin).",
  "scripts": {
    "test": "playwright test",
    "test:tickets": "playwright test --grep @tickets",
    "test:local": "PREPUBLISH_URL=http://localhost:3200 playwright test --project=local-fulfilment",
    "report": "playwright show-report reports/html",
    "summary": "node summarise.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.57.0",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.2"
  }
}
