{
  "name": "kgc",
  "private": true,
  "workspaces": [
    "app",
    "functions",
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspace=app",
    "start": "npm run start --workspace=app",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/rules\"",
    "seed": "npm run seed --workspace=@kgc/scripts --",
    "import:whova": "npm run import:whova --workspace=@kgc/scripts --",
    "test": "vitest run scripts/src app/src tests/qr tests/programme",
    "test:functions": "npm run build --workspace=functions && firebase emulators:exec --only firestore,functions \"npm run seed && vitest run tests/functions --no-file-parallelism\"",
    "claims": "npm run claims --workspace=@kgc/scripts --",
    "dev:emulators": "firebase emulators:start --only firestore,auth,functions",
    "web": "npm run web --workspace=app",
    "ios": "npm run ios --workspace=app",
    "android": "npm run android --workspace=app",
    "dev": "npm run start --workspace=app",
    "test:commerce": "firebase emulators:exec --only firestore \"vitest run tests/commerce\"",
    "test:programme": "vitest run tests/programme",
    "smoke": "bash scripts/smoke-dashboard.sh"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-tools": "^15.27.0",
    "vitest": "^4.1.10"
  }
}
