rules_version = '2';

// Default posture: everything is closed. Content (sessions, speakers, sponsors)
// is readable only by registered attendees, and written only by organizers.
//
// THE GATE IS A CUSTOM CLAIM
// `registered` and `roles` are minted by the OTP sign-in function and carried in
// the ID token. Nothing here reads a document to decide who you are. That matters
// for more than speed: a single-document request may make at most 10 access calls
// and a query at most 20, and exceeding it is a hard error, not a slowdown. An
// earlier version looked up `registrations` and `users` on every evaluation and
// would have hit that ceiling as rules grew.
//
// COUNTERS AND TALLIES ARE SERVER-OWNED
// `replyCount`, `reactionCount`, `upvoteCount`, poll `tallies` and `totalVotes`
// are written only by Cloud Function triggers, which bypass rules entirely. No
// client path can touch them. An earlier version let clients move a counter by
// +/-1, which bounded a single write but not a loop of them.
//
// "No client path" includes the organizer ones. An organizer is a client with a
// role, not a server: every organizer branch that updates a document an
// attendee authored is an allowlist, so moderation cannot move a counter and
// cannot rewrite `authorId` — which would put an attendee's name above words
// they never wrote.
//
// FIELDS CANNOT BE FILTERED, ONLY DOCUMENTS
// Rules decide whether a whole document is readable. Anything that must be hidden
// field-by-field has to live in a separate document written by a function — which
// is why the attendee directory is a projection (`directory/{uid}`) rather than a
// filtered view of `users/{uid}`, and why the exhibitor hall is
// `exhibitorListings/{id}` rather than a filtered view of `exhibitors/{id}`.
// `exhibitors` itself, and `booths` beside it, stay closed: between them they hold
// the booking contact's address, the staff-pass allocation, the order id and which
// spaces are promised but unpaid.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Being signed in is not enough — anyone can create a Firebase account.
    // `registered` is set by the sign-in function only for ticket holders.
    function isRegistered() {
      return signedIn() && request.auth.token.registered == true;
    }

    function hasRole(role) {
      return signedIn()
        && request.auth.token.roles is list
        && role in request.auth.token.roles;
    }

    // Organizer power is a role ON TOP OF a ticket, never instead of one. The
    // `roles` claim and the `registered` claim are minted together, so a token
    // carrying `organizer` without `registered` is a token that was assembled
    // somewhere other than the sign-in function — and that token could list all
    // of `/users`, which is the attendee table with everybody's email in it.
    function isOrganizer() {
      return isRegistered() && hasRole('organizer');
    }

    /** The set of top-level fields this write changes. */
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /** The signed-in address, folded to lower case the way registrations store it. */
    function myEmail() {
      return request.auth.token.email.lower();
    }

    /**
     * Whether a registration document belongs to the caller.
     *
     * Matched on the email address, not on the document id. The id is
     * `reg_` + sha256(email) — see `scripts/src/lib/ids.ts` — and the rules
     * language has no hash function, so the id proves nothing here. It is also
     * not matched on `claimedByUid`, because an attendee who has never opened the
     * app has no `claimedByUid` and still has to be able to reach their own
     * badge on first sign-in.
     *
     * BOTH SIDES ARE FOLDED TO LOWER CASE. `normaliseEmail()` lowercases on the
     * way in, so stored addresses are normalised in theory — but a registration
     * imported from a spreadsheet or repaired by hand in the console is not
     * guaranteed to be, and an ID token carries whatever the account was created
     * with. Comparing one lowercased side against one verbatim side is a badge
     * that loads for most attendees and silently refuses for whoever typed a
     * capital letter, which is the worst kind of bug to debug at a door.
     *
     * `altEmails` is read with a default rather than dereferenced. Mutation
     * testing showed this is belt-and-braces and NOT load-bearing, and the
     * comment says so rather than taking credit: a registration written before
     * the field existed has no `altEmails`, but its primary address is the one
     * that matches, so the left operand already decided the `||` and the missing
     * field is never reached. It stays because the day the two operands are
     * reordered, or a third is added, is the day it starts mattering — and
     * because a rule that throws is a rule that denies for a reason nobody can
     * read from a `permission-denied`.
     *
     * Its entries are compared verbatim: the rules language has no way to map
     * over a list, so alternates MUST be stored already lowercased.
     * `normaliseEmail()` is the only thing that should ever write them.
     */
    function registrationIsMine(data) {
      return isRegistered()
        && (data.email.lower() == myEmail() || myEmail() in data.get('altEmails', []));
    }

    // The imported ticket list. At $1,199 a seat the guest list is the
    // commercially sensitive asset in this database, so it stays unenumerable —
    // but it cannot stay entirely closed, because `qrSecret` lives here and it is
    // the badge. There is no server in this read path to hand it over: the
    // project is on Spark, there are no Cloud Functions, and these rules are the
    // whole authorization boundary.
    //
    // So the ticket holder, and only the ticket holder, may read their own row.
    // A query must be filtered to the caller's own address to be allowed at all,
    // which means an attacker can ask "is THIS address mine" and get "no" — they
    // learn nothing they did not already know. What they cannot do is list the
    // collection, read a row belonging to anybody else, or discover whether a
    // third party holds a ticket.
    match /registrations/{registrationId} {
      allow get, list: if registrationIsMine(resource.data);

      // Claiming: the app records which account picked this registration up, so
      // the console's attendee list can show who has actually arrived in the app.
      // An allowlist of two fields, and the uid must be the caller's own — this
      // is not a door into `status`, `ticketType`, `email` or `qrSecret`. Nobody
      // may cancel their own ticket into `active`, and nobody may rotate somebody
      // else's badge secret out from under a printed badge.
      allow update: if registrationIsMine(resource.data)
        && changed().hasOnly(['claimedByUid', 'updatedAt'])
        && request.resource.data.claimedByUid == request.auth.uid;

      allow create, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Check-in
    //
    // EVERY WRITE ON THIS PATH IS DENIED TO EVERY CLIENT, INCLUDING ORGANIZERS.
    //
    // That is not an oversight, it is the design. Check-ins are written by the
    // organizer console using the Admin SDK, which bypasses rules entirely, so
    // the client-facing rule can be `false` and lose nothing. And it must be
    // `false`, because the alternative is a rule that tries to distinguish "an
    // organizer at the door" from "an attendee with an organizer role", and there
    // is no such distinction in a token.
    //
    // The consequence worth stating plainly: an attendee cannot check themselves
    // in. Not their own record, not from the badge screen, not by writing the
    // document the scanner would have written. Attendance is an assertion made by
    // the door, and a self-service check-in is a $1,199 turnstile with no arm on
    // it.
    // -----------------------------------------------------------------------

    match /checkInLists/{listId} {
      // The lists themselves describe the event's door plan — which meals, which
      // workshops, which sessions gate on attendance. Attendees do not need it:
      // the badge reaches its own check-in through `DOOR_CHECK_IN_LIST_ID`, a
      // constant in `@kgc/shared`, so it never has to enumerate the lists.
      allow read: if isOrganizer();
      allow write: if false;

      match /checkIns/{registrationId} {
        /**
         * Ownership cannot be read off the path.
         *
         * `registrationId` is `reg_` + sha256(email), and rules cannot hash, so
         * the only way to know whether this check-in is the caller's is to look
         * at the registration it names. That is the second `get()` in this file
         * and it is worth it: the alternative is denormalising a uid onto the
         * check-in document, which the scanner can only supply for an attendee
         * who has already opened the app — so anyone scanned before installing it
         * could never see their own check-in.
         *
         * It costs one access call out of the ten a single-document request is
         * allowed, and one document read. The badge reads exactly one of these.
         *
         * `list` is deliberately absent from the attendee branch. A query cannot
         * be constrained to "the one whose registration is mine" — there is no
         * field on the check-in to filter on — so allowing it would allow reading
         * the whole door list, which is the attendance record of every attendee.
         */
        function isMyCheckIn() {
          // This `isRegistered()` is a COST control, not a security control, and
          // mutation testing proved it: removing it fails no test, because
          // `registrationIsMine` gates on the claim itself. It stays so the
          // access call and the document read are never spent on a caller who
          // cannot pass — an unauthenticated request is refused before it bills
          // anybody. Do not delete it thinking it is redundant; do not trust it
          // as the gate either.
          return isRegistered()
            && registrationIsMine(
                 get(/databases/$(database)/documents/registrations/$(registrationId)).data
               );
        }

        allow get: if isOrganizer() || isMyCheckIn();
        allow list: if isOrganizer();
        allow write: if false;
      }
    }

    // The raw scan log: every scan, including the ones that matched nobody. It is
    // an operational record and it holds `qrSecret` values in plaintext, which
    // are badge credentials — so it is organizer-read and nobody-write.
    match /scanEvents/{scanEventId} {
      // The id is `{deviceId}_{clientScanId}`. NOTHING here parses it. Splitting
      // an id on `_` to recover a part of it is the mistake that broke every
      // message in this app at the rules layer — `deviceId` is `dev_…` and the
      // separator is not unambiguous. Both halves are stored as fields for
      // exactly this reason.
      allow read: if isOrganizer();
      allow write: if false;
    }

    // The scan desks. `label` is operator-facing and `lastSeenAt` says which
    // desks are live, which is a war-room read, not an attendee one.
    match /checkInStations/{stationId} {
      allow read: if isOrganizer();
      allow write: if false;
    }

    // The full profile. Readable by its owner and by organizers only — other
    // attendees see the `directory/{uid}` projection instead, so a hidden
    // attendee's record never leaves the server at all.
    match /users/{uid} {
      allow read: if isSelf(uid) || isOrganizer();

      /**
       * The same hostname constraint `mirrorDirectory`
       * (`functions/src/triggers/mirror-directory.ts`) applies before ever
       * copying `photoURL` into the ~1,000-attendee-visible `directory/{uid}`
       * projection — applied here too, directly on the source field, so the
       * protection does not depend on every future reader of `users/{uid}`
       * routing through that mirror. Today only the owner and organizers can
       * read this document, but nothing stops a later organizer screen or
       * console tool from rendering `users/{uid}.photoURL` straight into an
       * `<Image>`, which is exactly the beacon `mirrorDirectory`'s own check
       * exists to prevent.
       *
       * `matches()` requires a *full* match in this rules language, so the
       * pattern doubles as an exact-hostname check: anything after the
       * required `https://firebasestorage.googleapis.com/` prefix is
       * legitimate path/query, but nothing may come *before* it, which is
       * what rules out userinfo/subdomain tricks such as
       * `https://firebasestorage.googleapis.com@evil.example/` or
       * `https://firebasestorage.googleapis.com.evil.example/`.
       */
      function isFirebaseStorageUrl(url) {
        return url is string
          && url.matches('^https://firebasestorage\\.googleapis\\.com/.*$');
      }

      // Created client-side on first sign-in, so it must be constrained: your
      // own document, and you cannot grant yourself a role.
      //
      // The field checks are conditional on the field being PRESENT, not on
      // it being supplied. `me/index.tsx` saves a privacy switch with
      // `setDoc(..., {merge: true})`, and a merge onto a document that does not
      // exist yet is a create carrying two fields — so demanding `email` and
      // `roles` in every create made the privacy toggle fail outright for any
      // attendee who had not been seeded a profile. Role pinning is unchanged:
      // a create that mentions `roles` may still only say `['attendee']`, and
      // `update` cannot move it at all.
      allow create: if isSelf(uid)
        && isRegistered()
        && (!('email' in request.resource.data)
            || request.resource.data.email == request.auth.token.email.lower())
        && (!('roles' in request.resource.data)
            || request.resource.data.roles == ['attendee'])
        && (!('photoURL' in request.resource.data)
            || isFirebaseStorageUrl(request.resource.data.photoURL));

      // An allowlist, so `roles`, `email` and `eventId` cannot move and no
      // unexpected field can be introduced.
      //
      // `photoURL` is validated only when THIS write actually changes it
      // (`changed()`, not a bare presence check on the resulting document) —
      // otherwise every unrelated edit (renaming yourself, flipping a privacy
      // switch) on a profile that already carries a value from before this
      // rule existed would start failing on a field the write never touched.
      // And when it does change, an outright field *removal* is allowed
      // through untouched: `FieldValue.delete()` makes `photoURL` disappear
      // from `request.resource.data`, so there is nothing left to validate.
      allow update: if isSelf(uid)
        && changed().hasOnly([
          'name', 'photoURL', 'title', 'company', 'bio', 'interests',
          'social', 'onboarded', 'visibleInDirectory', 'messagingEnabled',
          'notificationPrefs', 'updatedAt',
        ])
        && (!('photoURL' in changed())
            || !('photoURL' in request.resource.data)
            || isFirebaseStorageUrl(request.resource.data.photoURL));
      allow delete: if false;

      // The three subcollections below are private per-user storage, and until
      // this gate they were the one place in the file where being signed in was
      // enough. Anyone who can create a Firebase account — which is anyone —
      // could park unbounded documents under their own uid forever, billed to
      // the conference. `isRegistered()` costs a ticket; the field allowlists
      // stop a document being used as a bucket.
      match /savedSessions/{sessionId} {
        allow read, delete: if isSelf(uid) && isRegistered();
        allow create, update: if isSelf(uid) && isRegistered()
          && request.resource.data.keys().hasOnly(['sessionId', 'savedAt', 'remind']);
      }
      match /savedContacts/{contactUid} {
        allow read, delete: if isSelf(uid) && isRegistered();
        allow create, update: if isSelf(uid) && isRegistered()
          && request.resource.data.keys().hasOnly(['contactUid', 'note', 'savedAt'])
          // The only free text on the path, so the only thing worth bounding.
          && (!('note' in request.resource.data)
              || (request.resource.data.note is string
                  && request.resource.data.note.size() <= 1000));
      }
      match /notifications/{id} {
        // Written only by functions; the owner may mark them read. `hasOnly`
        // is the whole point of the branch — "mark read" must not be a way to
        // rewrite the title and body of a notification the server sent.
        allow read: if isSelf(uid);
        allow update: if isSelf(uid) && changed().hasOnly(['read']);
        allow create, delete: if false;
      }
      match /fcmTokens/{token} {
        allow read, delete: if isSelf(uid) && isRegistered();
        allow create, update: if isSelf(uid) && isRegistered()
          && request.resource.data.keys().hasOnly(['token', 'platform', 'deviceName', 'createdAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() <= 4096
          && (!('deviceName' in request.resource.data)
              || (request.resource.data.deviceName is string
                  && request.resource.data.deviceName.size() <= 120));
      }

      /**
       * "Which table am I at?" — the attendee's own seating placements.
       *
       * ── Why this is a projection and not a rule on `gatherings` ───────────
       *
       * `gatherings/{id}` is the organizer's seating plan and it has no match
       * block, which is correct and must stay that way. One document carries
       * `attendees` — the full list of everyone placed at that table, typed by
       * an organizer — plus `notes`, which is where "sponsor wants to be sat
       * away from X" gets written, plus `status: 'planned'`, a table that has
       * been sketched and not agreed. A ticket holder able to read the
       * collection could reconstruct the room, and half the names in it belong
       * to people who are not attendees at all: sponsor contacts, a partner's
       * staff, a speaker's assistant. There is no predicate that returns the
       * caller's own seat and withholds the other eleven, so a filtered view is
       * not on the table — the same argument `directory` settles for `users`
       * and `exhibitorListings` settles for `exhibitors`, settled the same way.
       *
       * ── ⚠️ Nothing writes this yet, and that is a real gap ────────────────
       *
       * `GatheringDoc.attendees` is a list of *names*, not uids, because an
       * organizer types them and half of them have no account. A mirror
       * trigger therefore has no key to fan out on: matching a typed name
       * against `users.name` would place the wrong Chen at the wrong table,
       * which is worse than showing nothing. The writer is a follow-up and it
       * needs a uid on the placement first — see the docblock on
       * `GatheringPlacementDoc`. The reader below and the app screen that uses
       * it render nothing until it exists, deliberately: an empty section is
       * absent, not a claim.
       *
       * Read-only to its owner, like `notifications`. `isRegistered()` is not
       * required to read — a placement is the caller's own document under
       * their own uid, and refusing it to a holder whose claim has lapsed
       * would hide their table from them at exactly the wrong moment.
       */
      match /gatherings/{gatheringId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // The directory projection. Opting out means absent, not filtered — the
    // document is deleted, so a hidden attendee's data never reaches another
    // device at all.
    //
    // Eventually the `mirrorDirectory` trigger owns this. Until Cloud Functions
    // exist, the owner maintains their own entry, because a privacy switch that
    // silently does nothing is worse than having no switch. The write is
    // constrained so it cannot become a channel for arbitrary data: the uid must
    // match both the path and the caller, and the field set is closed.
    match /directory/{uid} {
      allow read: if isRegistered();
      // `hasOnly` closes the key set but validates no VALUES — every field below
      // is bounded deliberately. This document is fetched whole by all ~1,000
      // attendees, so an unvalidated write here is not self-harm:
      //   · a missing or non-string `name` throws inside the snapshot success
      //     callback, which `use-collection.ts` does not guard, white-screening
      //     the People tab for everyone;
      //   · a 700 KB `name` blows a ~450 KB budget for every device;
      //   · a free-text `title` impersonates "KGC Registration Desk".
      // `photoURL` is deliberately NOT writable from a client: it would render
      // an attacker-controlled URL in every attendee's `<Image>` — a beacon that
      // collects 1,000 IP addresses. The mirror trigger sets it from the profile.
      function validDirectoryEntry() {
        let d = request.resource.data;
        return d.uid == uid
          && d.keys().hasAll(['eventId', 'uid', 'name'])
          && d.keys().hasOnly(['eventId', 'uid', 'name', 'title', 'company', 'interests', 'updatedAt'])
          && d.eventId is string
          && d.name is string && d.name.size() > 0 && d.name.size() <= 120
          && (!('title' in d) || (d.title is string && d.title.size() <= 120))
          && (!('company' in d) || (d.company is string && d.company.size() <= 120))
          && (!('interests' in d) || (d.interests is list && d.interests.size() <= 20));
      }

      allow create, update: if isSelf(uid) && isRegistered() && validDirectoryEntry();
      allow delete: if isSelf(uid);
    }

    match /sessions/{sessionId} {
      // Only published sessions leave the server. `sessions.ts` also filters
      // client-side, but that is cosmetic — without this predicate an embargoed
      // keynote and its speaker are on the wire the moment they are drafted, and
      // "unpublish" hides nothing. A list query must filter on `status` to be
      // allowed at all, which the app already does.
      allow read: if isRegistered()
        && (resource.data.status == 'published' || isOrganizer());
      allow create, update: if isOrganizer();
      // Never hard-deleted: attendees have it saved, and Firestore has no
      // server-side cascade. Unpublishing is a `status` transition.
      allow delete: if false;

      match /questions/{questionId} {
        allow read: if isRegistered();
        // `state` is moderation state, so it is not the author's to set: a
        // question that arrives `approved` is on the keynote screen without a
        // moderator ever having seen it, which is the entire point of having
        // the field. Every question starts life pending.
        allow create: if isRegistered()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.upvoteCount == 0
          && request.resource.data.answered == false
          && request.resource.data.state == 'pending';

        // Authors may correct their own wording; organizers may moderate.
        // Both branches are allowlists. Moderating a question is approving it,
        // hiding it or redacting it — it is not raising its `upvoteCount` onto
        // the screen, and it is certainly not rewriting `authorId` so that an
        // attendee is the signed author of something they did not ask.
        allow update: if (isOrganizer()
              && changed().hasOnly(['state', 'answered', 'body', 'editedAt']))
          || (isRegistered() && resource.data.authorId == request.auth.uid
              && changed().hasOnly(['body', 'editedAt']));

        allow delete: if isOrganizer()
          || (isRegistered() && resource.data.authorId == request.auth.uid);

        // One document per upvoter, keyed by uid, so a user can only ever add
        // or remove their own vote. A trigger derives the count.
        match /upvotes/{uid} {
          allow read: if isRegistered();
          allow create: if isSelf(uid) && isRegistered()
            && request.resource.data.uid == request.auth.uid;
          allow delete: if isSelf(uid);
          allow update: if false;
        }
      }

      match /polls/{pollId} {
        allow read: if isRegistered();
        allow delete: if isOrganizer();

        // A poll must arrive with one `tallies` key per option. That is not
        // bookkeeping: `tallies` is keyed by option id, and its key set is the
        // only place a ballot's options can be checked against, because rules
        // have no way to project `id` out of a list of `{id, label}` maps —
        // there is no map or comprehension operator in the language. Seeding
        // the keys at creation is what makes `validBallot()` below meaningful.
        allow create: if isOrganizer()
          && request.resource.data.options is list
          && request.resource.data.options.size() > 0
          && request.resource.data.options.size() <= 20
          && request.resource.data.tallies is map
          && request.resource.data.tallies.keys().size() == request.resource.data.options.size()
          && request.resource.data.totalVotes == 0;

        // Organizers control the question and whether it is open. `tallies` and
        // `totalVotes` are function-owned and appear in no client allowlist.
        allow update: if isOrganizer()
          && changed().hasOnly(['question', 'options', 'open', 'updatedAt']);

        /**
         * A ballot, checked against the poll it belongs to.
         *
         * `poll` is passed in rather than read here, because the caller already
         * holds the one `get()` this file makes and a request may make at most
         * ten access calls.
         */
        function validBallot(poll) {
          let ids = request.resource.data.optionIds;
          return poll.open == true
            && ids is list
            && ids.size() > 0
            && ids.size() <= 20
            // No stuffing the same option in twice to move a multi-select tally.
            && ids.toSet().size() == ids.size()
            && poll.tallies.keys().hasAll(ids);
        }

        // One document per voter. This is the fix for the original design, where
        // every vote rewrote a single map on the poll document: 1,000 voters
        // against a ~1 write/sec/document limit took over 16 minutes to drain.
        match /votes/{uid} {
          // A ballot is secret. Only its owner and the organizers running the
          // poll may read it — never the person sitting in the next seat.
          allow read: if isSelf(uid) || isOrganizer();
          allow create, update: if isSelf(uid)
            && isRegistered()
            && request.resource.data.uid == request.auth.uid
            // One of the four access calls in this file. It is on a write path
            // rather than every read, and it does double duty: closing a poll has to
            // mean something, and a ballot has to name options the poll has.
            // An unvalidated ballot is not a nuisance — `tallyPoll` counts what
            // it is given, so fabricated ids invent options on the live result
            // screen and 5,000 of them in one document invent them at scale.
            && validBallot(get(/databases/$(database)/documents/sessions/$(sessionId)/polls/$(pollId)).data);
          allow delete: if false;
        }
      }
    }

    match /speakers/{id} {
      allow read: if isRegistered();
      allow write: if isOrganizer();
    }

    match /tracks/{id} {
      allow read: if isRegistered();
      allow write: if isOrganizer();
    }

    match /sponsors/{sponsorId} {
      allow read: if isRegistered();
      allow write: if isOrganizer();

      // An attendee may submit their own lead but must never read another's.
      match /leads/{uid} {
        allow create: if isSelf(uid) && isRegistered();
        allow read: if isOrganizer();
        allow update, delete: if false;
      }
    }

    match /announcements/{id} {
      allow read: if isRegistered();
      allow write: if isOrganizer();
    }

    /**
     * Organizer-authored preference bags — one document per feature area, and
     * exactly ONE of them readable by a phone.
     *
     * ── Why the key is in the predicate ─────────────────────────────────────
     *
     * `settings/logistics` is the emergency card: the venue security number,
     * the medical point, the assembly point and who to call. It is the one bag
     * whose whole purpose is to be read by somebody standing in the building.
     * `settings/access` is not: it holds `eventCode`, a shared string read out
     * from the stage, and `staffNote`, written for the check-in desk. Rules
     * filter documents and not fields, so a blanket `match /settings/{key}`
     * would hand both to every device. Naming the key is the filter.
     *
     * If a *field* of `logistics` ever turns out to be internal —
     * `incidentProcedure` is the candidate, since it may name a person's
     * mobile — the answer is a projection, the way `exhibitorListings`
     * projects `exhibitors`, not a wider rule here.
     *
     * ── Both verbs, and why a `list` is denied ──────────────────────────────
     *
     * `key` is a path variable, so it is bound on a `get` and unbound across a
     * query on the collection: `key == 'logistics'` is therefore true for the
     * one document and false for a `list` of `/settings`, which denies the
     * query outright. That is the wanted outcome rather than a limitation —
     * an enumerable `/settings` is `access` on every phone — and it is why the
     * app reads this with `useDocument` on a single path and never queries the
     * collection. Both verbs are pinned in `tests/rules/firestore.test.ts`,
     * because a predicate that works on a `get` and denies a `list` is exactly
     * how the inbox broke once, and here that asymmetry is load-bearing.
     */
    match /settings/{key} {
      allow read: if isRegistered() && key == 'logistics';
      // Admin SDK only, like every other settings write. The dashboard's
      // `saveSettings` runs server-side and bypasses rules; an organizer is a
      // client with a role, and a client that could write this could put an
      // attacker-chosen phone number on the emergency card.
      allow write: if false;
    }

    /**
     * The exhibitor hall, as a projection.
     *
     * ── Why not `exhibitors/{id}` itself ────────────────────────────────────
     *
     * Rules filter documents, not fields, and `ExhibitorDoc` carries three
     * things an attendee must not have: the booking contact's name and email
     * address, so a readable list is a harvestable one; `passesAllocated` and
     * `passesUsed`, which are the commercial terms of the package that
     * exhibitor bought; and `status`, where `provisional` names a space
     * promised in a sales conversation that nobody has paid for. There is no
     * predicate that hands over the name and withholds the rest, so a filtered
     * view is not on the table. This is the same argument `directory/{uid}`
     * settles for `users/{uid}`, and it is settled the same way.
     *
     * A cancelled or provisional exhibitor has no listing document at all —
     * absent rather than filtered, again as in the directory. Nothing about
     * them is on the wire to be filtered client-side, and this collection
     * carries no `status` field for anyone to reason about.
     *
     * ── Both verbs, and why the predicate is bare ───────────────────────────
     *
     * `isRegistered()` and nothing else. A predicate reading `resource.data`
     * would evaluate against null on a `list` and deny the whole query, which
     * is how the inbox broke once — and there is nothing here to predicate on,
     * because the decision about which exhibitors are public was already made
     * by whether the document exists. The list is deliberately enumerable by a
     * ticket holder: an exhibitor hall that cannot be listed is not a listing.
     *
     * `booths` is deliberately still absent from this file. A booth document
     * holds an order id, a ticket type, an `assignedBy`, a `held`-but-unpaid
     * state and a note explaining why a space is unsellable. The booth *number*
     * is denormalised onto the listing, which is all the app ever needed.
     */
    match /exhibitorListings/{exhibitorId} {
      allow read: if isRegistered();
      // Server-written, like every other projection here. The seed and (once it
      // exists) the mirror trigger use the Admin SDK and bypass rules; an
      // organizer is a client with a role, and a client that could write this
      // could put an attacker-controlled `logoURL` in front of a thousand
      // devices, which is the beacon `directory` refuses for the same reason.
      allow write: if false;
    }

    /**
     * Surveys — session feedback and the post-event survey.
     *
     * The `status` predicate is the one `sessions` already makes, for the same
     * reason: a draft survey is a question an organizer is still deciding
     * whether to ask, and without this it is on the wire the moment it is
     * typed. It also means a `list` must filter on `status` to be permitted at
     * all, because `resource.data` is null across a query — which the app's
     * `useSurveys` does, and which the suite asserts in both verbs.
     *
     * No client write branch. Every survey is authored through the console with
     * the Admin SDK, and `responseCount` is a server-owned tally like every
     * other count in this file.
     */
    match /surveys/{surveyId} {
      allow read: if isRegistered()
        && (resource.data.status == 'published' || isOrganizer());
      allow write: if false;

      /**
       * One response per respondent, keyed by uid — the shape reactions,
       * upvotes and ballots all use, and for the same reason: rules can verify
       * that a writer touched their own entry in a subcollection, and cannot
       * verify that they touched only their own key inside a map.
       *
       * **Answering twice is refused here, not in the UI.** `update` and
       * `delete` are both closed, so a second submission fails at the boundary
       * however it is issued. The screen checks its own response first and
       * shows the answers back rather than the form, but that check is a
       * courtesy — this is the guarantee.
       *
       * A response is private. `isSelf(uid)` resolves on a `get`, which is what
       * the screen makes, and is false across a `list`, so an attendee cannot
       * enumerate the room's opinions of a session. Organizers can, and read
       * them through the console's aggregate.
       *
       * The write is bounded rather than merely authenticated: `answers` is a
       * free-form map, so without a cap it is a general-purpose write channel
       * into a collection an organizer's dashboard reads and renders. Thirty is
       * the console's own ceiling on questions.
       */
      match /responses/{uid} {
        allow read: if isSelf(uid) || isOrganizer();
        allow create: if isSelf(uid) && isRegistered()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'answers', 'submittedAt'])
          && request.resource.data.answers is map
          && request.resource.data.answers.keys().size() <= 30;
        allow update, delete: if false;
      }
    }


    /**
     * CONSENT — the one collection here that is a legal record
     *
     * `consentForms/{id}` is the published wording; the signatures are
     * underneath it. Everything about this block is shaped by the fact that a
     * consent record which can be changed after the fact records nothing at
     * all.
     *
     * The form itself is authored only by the dashboard, with the Admin SDK, so
     * there is no client write branch — the same posture `surveys` has. A
     * *published* form is readable by any ticket holder, because somebody has to
     * be able to read the wording in order to agree to it; a draft is wording an
     * organizer is still arguing about and is organizer-only.
     */
    match /consentForms/{formId} {
      allow read: if isRegistered()
        && (resource.data.status == 'published' || isOrganizer());
      allow write: if false;

      /**
       * One signature, at `{uid}_v{version}` — see `consentResponseId()`.
       *
       * ── Append-only, and that is the whole point ────────────────────────
       *
       * `update` and `delete` are closed to everybody, organizers included.
       * The dashboard reads this subcollection with the Admin SDK and has no
       * write path to it at all, so denying every client write costs nothing
       * and closes the question of whether a signature can be revised later.
       * Signing twice at the same version is refused by Firestore itself: the
       * id already exists, so the `create` fails with `already-exists`.
       *
       * ── The version is pinned to the form, not asserted by the signer ───
       *
       * This is the FOURTH `get()` in this file, and unlike the other three it
       * is not there to prove who you are. AGENTS.md is right that adding one is
       * a decision rather than a detail — the ceiling is 10 access calls on a
       * single-document request — and this is a `create` on one document, so it
       * spends one of ten.
       *
       * What it buys is the only property that makes the record worth keeping.
       * Without it, `formVersion` and `bodyHash` are whatever the client typed:
       * a signature could name a version that was never published, or an older
       * and more permissive wording, and the register would show it as a
       * signature like any other. Reading the parent form makes the stored
       * version and hash *the ones the form actually had at the moment of
       * signing*, which is what an organizer is relying on when they publish a
       * photograph on the strength of this row.
       *
       * It also closes the smaller hole in the same move: a draft form cannot
       * be signed, because `status` is read from the same document.
       *
       * ── Reading ─────────────────────────────────────────────────────────
       *
       * You may read your own signature and nobody else's, and nobody at all may
       * enumerate the register — not another attendee and not an organizer's
       * browser tab. A consent register is a list of who has and has not agreed
       * to be photographed, which is not something a shared-passphrase session
       * in a browser should be able to pull; the dashboard reads it with the
       * Admin SDK, which bypasses these rules. If the dashboard ever stops using
       * the Admin SDK, this path needs a rule of its own, not a loosening of
       * this one.
       *
       * A query is permitted only when it is filtered to your own uid, which is
       * the same shape the ticket list has: Firestore proves the rule from the
       * filter, so `where('uid', '==', me)` returns your own signatures and an
       * unfiltered `list` is refused outright. That is worth having rather than
       * merely tolerating — "which versions have I signed?" is one query instead
       * of one `get` per version — and it discloses nothing, because a filter
       * naming somebody else fails.
       *
       * ⚠️ This comment previously claimed a `list` was impossible here. It was
       * written from the observation that `resource.data` is null across a query
       * and it was simply wrong; the suite caught it on the first run. Firestore
       * evaluates a query against its constraints, which is exactly why
       * `registrations` is queryable by the holder's own address.
       *
       * `.get('uid', '')` rather than `resource.data.uid`, because a link-signed
       * response has no `uid` field and dereferencing an absent field throws,
       * which Firestore reports as permission-denied. The signer would see their
       * own signature refused with an error naming nothing.
       */
      match /responses/{responseId} {
        function form() {
          return get(/databases/$(database)/documents/consentForms/$(formId));
        }

        allow read: if isRegistered()
          && resource.data.get('uid', '') == request.auth.uid;

        allow create: if isRegistered()
          && form() != null
          && form().data.status == 'published'
          // The id carries the version, so this is also what stops one person
          // holding two signatures at the same version.
          && responseId == request.auth.uid + '_v' + string(form().data.version)
          && request.resource.data.formVersion == form().data.version
          && request.resource.data.bodyHash == form().data.bodyHash
          && request.resource.data.audience == form().data.audience
          && request.resource.data.formId == formId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.signatory == request.auth.uid
          // A refusal is a form that was never submitted. There is no way to
          // record "I do not agree" here, and a `false` would be one.
          && request.resource.data.agreed == true
          && request.resource.data.channel == 'app'
          // The typed name is the signature. Bounded because it is free text
          // that an organizer's dashboard renders.
          && request.resource.data.signedName is string
          && request.resource.data.signedName.size() >= 2
          && request.resource.data.signedName.size() <= 120
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 320
          && request.resource.data.signedAt is timestamp
          // `ip` and `userAgent` are deliberately NOT in this list. A client
          // that can write its own IP address can write any address, so the
          // field would be a self-reported value dressed as evidence. The link
          // channel records them because the server observes them.
          && request.resource.data.keys().hasOnly([
              'formId', 'formVersion', 'bodyHash', 'audience', 'signatory',
              'uid', 'email', 'signedName', 'agreed', 'signedAt', 'channel'
            ])
          && request.resource.data.keys().hasAll([
              'formId', 'formVersion', 'bodyHash', 'audience', 'signatory',
              'uid', 'email', 'signedName', 'agreed', 'signedAt', 'channel'
            ]);

        allow update, delete: if false;
      }
    }


    /**
     * THE CALL FOR ABSTRACTS IS ABSENT FROM THIS FILE, ON PURPOSE
     *
     * `calls`, `submissions`, `submissions/{id}/identity`,
     * `submissions/{id}/reviews/{reviewerId}` and `reviewers` have no `match`
     * block, so Firestore's default deny covers all five. That is the same
     * posture `orders`, `ticketTypes` and `emailLog` have, and it is asserted in
     * `tests/rules/firestore.test.ts` on both verbs — "secure because nobody
     * wrote a rule" is a property a later edit can remove without noticing.
     *
     * ── Why there is nothing here to write ──────────────────────────────────
     *
     * The gate in this file is `isRegistered()`, and it is false for everybody
     * this feature exists for. A prospective speaker holds no ticket; a call for
     * papers that requires one is not a call for papers. An external reviewer is
     * in the same position — `CFA-PLAN.md` §3. Both reach their own work through
     * an HMAC capability token and a server action, the scheme `/order/{token}`
     * already proves, so there is no client identity on this path for a rule to
     * evaluate. A rule that let *anybody* in would be letting in everybody.
     *
     * ── And why widening it for organizers would be worse, not easier ───────
     *
     * An organizer is a client with a role, not a server, and the dashboard
     * reads these with the Admin SDK. A `list` of `submissions` is every
     * unpublished abstract in the call; a `list` of `identity` is the address
     * of everybody who has ever submitted, which is a better mailing list than
     * anything in `contacts`. Worse, the identity split is the whole of blind
     * review (`CFA-PLAN.md` §1.1): a collection-group query over `identity`
     * rejoins every anonymous submission to its author in one read, so the
     * anonymity is not a property of the review screen — it is a property of
     * nobody being able to ask.
     *
     * If a client ever does need one of these — an attendee-facing "calls open
     * now" list is the plausible one — it gets a projection written by the
     * server, the way `exhibitorListings` projects `exhibitors`. Not a loosening
     * here.
     */

    match /communityPosts/{postId} {
      allow read: if isRegistered();
      allow create: if isRegistered()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.replyCount == 0
        && request.resource.data.reactionCount == 0;

      // Authors may edit their own text — which Whova does not allow, and which
      // is one of the most common complaints about it. Counters are absent from
      // BOTH branches: an unlisted organizer branch is still a client branch,
      // and it let a console session move `replyCount` or, worse, rewrite
      // `authorId` so an attendee's name sits above a post they never wrote.
      // Moderation here is `status`, plus redacting the text.
      allow update: if (isOrganizer()
            && changed().hasOnly(['status', 'title', 'body', 'editedAt', 'updatedAt']))
        || (isRegistered() && resource.data.authorId == request.auth.uid
            && changed().hasOnly(['title', 'body', 'editedAt']));

      // Soft delete via `status`, so replies and reactions do not orphan.
      allow delete: if false;

      match /replies/{id} {
        allow read: if isRegistered();
        allow create: if isRegistered()
          && request.resource.data.authorId == request.auth.uid;
        // A reply was the one piece of user-generated text on the board that no
        // organizer could touch: not hide, not redact, not remove. An abusive
        // reply under a legitimate post had no answer short of the Admin SDK.
        //
        // The organizer branch is an allowlist over keys that may be ADDED as
        // well as changed: `status` arrived on `CommunityReplyDoc` after the
        // first replies were written, and `diff().affectedKeys()` counts a new
        // key as affected — so a reply that predates the field moderates
        // cleanly rather than being permanently untouchable.
        allow update: if (isOrganizer()
              && changed().hasOnly(['status', 'body', 'editedAt']))
          || (isRegistered() && resource.data.authorId == request.auth.uid
              && changed().hasOnly(['body', 'editedAt']));

        // Unlike a post, a reply has nothing hanging off it, so there is
        // nothing to orphan and a hard delete is safe. Authors may retract
        // their own; organizers may remove anyone's.
        allow delete: if isOrganizer()
          || (isRegistered() && resource.data.authorId == request.auth.uid);
      }

      // One document per reacting user, keyed by uid.
      match /reactions/{uid} {
        allow read: if isRegistered();
        allow create, update: if isSelf(uid) && isRegistered()
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isSelf(uid);
      }
    }

    // Thread ids are the two participant uids sorted and joined with '_'.
    //
    // An earlier version proved membership by splitting that id on '_', on the
    // stated grounds that "Firebase uids are alphanumeric, so the separator is
    // unambiguous". That assumption was false in this very repo: the seeded
    // accounts are `demo_000`, `demo_001`, so `demo_000_demo_001` split to
    // ['demo','000','demo','001'] and contained neither participant. Every
    // message read and every send was denied — while the inbox itself kept
    // working, because that branch reads `participantIds`, so it looked as
    // though the messages had been deleted rather than as though a rule was
    // wrong.
    //
    // Nothing below parses the id any more. Membership comes from the document,
    // and the id is bound to its participants by *reconstructing* it rather than
    // taking it apart — which is correct whatever a uid happens to contain.
    match /threads/{threadId} {
      /**
       * Membership from the document, for reads.
       *
       * NOT from the path. On a `list` the `{threadId}` wildcard is not bound
       * the way it is on a `get`, so any check derived from the id evaluates
       * against null and the whole inbox query fails. The client query filters
       * on `participantIds array-contains uid`, which satisfies this.
       */
      function isParticipant() {
        return isRegistered() && request.auth.uid in resource.data.participantIds;
      }

      /**
       * The id a pair of uids must produce, in either sort order.
       *
       * Built by concatenation, never by splitting, so a uid containing the
       * separator cannot break it.
       */
      function idMatchesParticipants(pair) {
        return threadId == pair[0] + '_' + pair[1]
            || threadId == pair[1] + '_' + pair[0];
      }

      /**
       * What a participant may write to the thread's metadata.
       *
       * `unread` is a two-key map that both participants can write, which makes
       * it the one counter in this file a client owns — so it is bounded by
       * shape rather than by trust. It is checked as the map the write RESULTS
       * in, which is what makes the check indifferent to how the client got
       * there: a whole-map rewrite, a dot-path on one key, and an `increment()`
       * transform all land in `request.resource.data.unread` already resolved.
       * You may only ever zero YOUR OWN side, and you may only ever move the
       * other side by +1 — one message, one increment. Unconstrained, a
       * participant could park a 999999 badge on someone's inbox, or zero the
       * other side to hide the message they just sent, or set `lastSenderId` to
       * the other person so the inbox row attributes their own words to them.
       */
      function metadataWriteIsSane() {
        let me = request.auth.uid;
        let other = resource.data.participantIds[0] == me
          ? resource.data.participantIds[1]
          : resource.data.participantIds[0];
        let next = request.resource.data.unread;
        return (!changed().hasAny(['lastSenderId'])
              || request.resource.data.lastSenderId == me)
          && (!changed().hasAny(['unread'])
              || (next.keys().hasOnly([me, other])
                  && next.keys().hasAll([me, other])
                  && next.get(me, -1) == 0
                  && next.get(other, -1) is int
                  && next.get(other, -1) >= resource.data.unread.get(other, 0)
                  && next.get(other, -1) <= resource.data.unread.get(other, 0) + 1));
      }

      // `resource` is null when the document does not exist, and dereferencing
      // it throws — which Firestore reports as permission-denied rather than
      // not-found. Reading a conversation before anyone has spoken in it is
      // routine: any screen opening a thread from the directory does it.
      // A read of a document that is not there discloses nothing, so it needs
      // no membership test of its own.
      allow read: if isRegistered()
        && (resource == null
            || request.auth.uid in resource.data.participantIds);
      // On create there is no `resource` to check against, so the guarantee has
      // to come from the id itself: you must be one of the two participants,
      // and the id must be the one those two produce. That is what stops a
      // thread being minted between two other people.
      allow create: if isRegistered()
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && idMatchesParticipants(request.resource.data.participantIds);
      // Participants may not rewrite who is in the thread.
      allow update: if isParticipant()
        && changed().hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'unread'])
        && metadataWriteIsSane();
      allow delete: if false;

      match /messages/{id} {
        /**
         * Membership read from the parent thread.
         *
         * This is the `get()` the old path-splitting trick existed to avoid,
         * and paying for it is the right trade: the optimisation rested on an
         * assumption about uid contents that turned out to be untrue, and it
         * silently denied every message in the app. Access calls are cached
         * within a request, so a fifty-message page costs one, against a limit
         * of ten per document request and twenty per query.
         */
        function thread() {
          return get(/databases/$(database)/documents/threads/$(threadId));
        }

        function inThread() {
          return isRegistered()
            && request.auth.uid in thread().data.participantIds;
        }

        /**
         * A conversation nobody has spoken in yet has no thread document, and
         * reading one is the most common thing that happens on this path: every
         * "Say Hi" from the directory opens one, and 47 of the 50 demo attendees
         * have no thread with you. `get()` returns null for a document that does
         * not exist and `null.data` is an error, so the version above denied all
         * of those reads — which the new error states then rendered, correctly
         * and alarmingly, as a full-page "the server refused to send this
         * conversation" with a Sign out button underneath.
         *
         * Tolerating the missing parent on `read` discloses nothing, because
         * there are no documents in the subcollection to return. It is the same
         * trade the parent `threads` rule already makes, for the same reason.
         *
         * `create` deliberately does NOT get the same tolerance. A write into a
         * thread that does not exist would let anyone drop a message, carrying
         * their own `senderId`, into any future conversation between any two
         * people — sitting there waiting when one of them first opened it. So the
         * client must write the thread document before the first message in it,
         * which is the ordering `sendMessage` now uses.
         */
        function inThreadOrUnstarted() {
          return isRegistered()
            && (thread() == null
                || request.auth.uid in thread().data.participantIds);
        }

        allow read: if inThreadOrUnstarted();
        allow create: if inThread()
          && request.resource.data.senderId == request.auth.uid;
        // Immutable once sent. Moderation is a function's job.
        allow update, delete: if false;
      }
    }
  }
}
