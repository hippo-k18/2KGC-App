rules_version = '2';

// Default posture: everything is closed. Content (sessions, speakers, sponsors)
// is readable only by attendees whose address is on the imported ticket list,
// and is written only by organizers.
//
// NOTE ON THE REGISTRATION GATE
// The web build checked the ticket list in a server route using the Admin SDK.
// A native app has no server, so the check moved here into `isRegistered()`.
// That costs one extra document lookup per rule evaluation. When you add Cloud
// Functions, set a custom claim on the user at first sign-in and check
// `request.auth.token.registered` instead — it is free and much faster.
//
// NOTE ON SHARED COUNTERS
// `replyCount`, `reactionCount` and `upvoteCount` are maintained by clients.
// Rules below constrain each write to a change of exactly +/-1, so a client
// cannot set them arbitrarily, but a determined client could still call the
// increment repeatedly. Move them to Cloud Function triggers when you can.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // On the ticket list. This, not merely being signed in, is what grants
    // access — anyone can create a Firebase account, but only ticket holders
    // appear in `registrations`.
    function isRegistered() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/registrations/$(request.auth.token.email.lower()));
    }

    function isOrganizer() {
      return isRegistered()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organizer';
    }

    /** The set of top-level fields this write changes. */
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    /** True when `field` moves by exactly one, up or down. */
    function stepsByOne(field) {
      return request.resource.data[field] == resource.data[field] + 1
        || request.resource.data[field] == resource.data[field] - 1;
    }

    // The imported ticket list. An attendee may read only their own entry, so
    // the client can confirm eligibility; the list is never enumerable.
    match /registrations/{email} {
      allow get: if signedIn() && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    match /users/{uid} {
      // Honours the attendee's directory opt-out. Because rules are evaluated
      // per document, a directory query must filter on visibleInDirectory or
      // it will be rejected outright rather than silently leaking.
      allow read: if isRegistered()
        && (isSelf(uid)
            || isOrganizer()
            || resource.data.visibleInDirectory == true);

      // The profile is created client-side on first sign-in, so it must be
      // constrained: you may only create your own, and only as an attendee.
      allow create: if isSelf(uid)
        && isRegistered()
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.role == 'attendee';

      // An allowlist, so `role` and `email` cannot move and no unexpected
      // field can be introduced.
      allow update: if isSelf(uid)
        && changed().hasOnly([
          'name', 'photoURL', 'title', 'company', 'bio', 'interests',
          'social', 'onboarded', 'visibleInDirectory', 'notificationPrefs',
          'updatedAt',
        ]);
      allow delete: if false;

      match /savedSessions/{sessionId} {
        allow read, write: if isSelf(uid);
      }
      match /savedContacts/{contactUid} {
        allow read, write: if isSelf(uid);
      }
      match /notifications/{id} {
        allow read, update: if isSelf(uid);
        allow create, delete: if false;
      }
      match /fcmTokens/{token} {
        allow read, write: if isSelf(uid);
      }
    }

    match /sessions/{sessionId} {
      allow read: if isRegistered();
      allow write: if isOrganizer();

      match /questions/{questionId} {
        allow read: if isRegistered();
        allow create: if isRegistered()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.upvoteCount == 0
          && request.resource.data.answered == false;

        // Authors may correct their own wording; anyone may move the upvote
        // counter by one; organizers may mark a question answered.
        allow update: if isOrganizer()
          || (isRegistered() && changed().hasOnly(['upvoteCount'])
              && stepsByOne('upvoteCount'))
          || (isRegistered() && resource.data.authorId == request.auth.uid
              && changed().hasOnly(['body']));

        allow delete: if isOrganizer()
          || (isRegistered() && resource.data.authorId == request.auth.uid);

        // One document per upvoter, keyed by uid, so a user can only ever
        // add or remove their own vote.
        match /upvotes/{uid} {
          allow read: if isRegistered();
          allow create: if isSelf(uid) && isRegistered()
            && request.resource.data.uid == request.auth.uid;
          allow delete: if isSelf(uid);
          allow update: if false;
        }
      }

      match /polls/{id} {
        allow read: if isRegistered();
        allow create, delete: if isOrganizer();

        // `votes` is a map keyed by uid, so a voter can be held to their own
        // key. Everything else about the poll is the organizer's.
        allow update: if isOrganizer()
          || (isRegistered()
              && resource.data.open == true
              && changed().hasOnly(['votes'])
              && request.resource.data.votes.diff(resource.data.votes)
                   .affectedKeys().hasOnly([request.auth.uid]));
      }
    }

    match /speakers/{id} {
      allow read: if isRegistered();
      allow write: if isOrganizer();
    }

    match /tracks/{id} {
      allow read: if isRegistered();
      allow write: if isOrganizer();
    }

    match /sponsors/{sponsorId} {
      allow read: if isRegistered();
      allow write: if isOrganizer();

      // An attendee may submit their own lead but must not read others'.
      match /leads/{uid} {
        allow create: if isSelf(uid) && isRegistered();
        allow read: if isOrganizer();
        allow update, delete: if false;
      }
    }

    match /announcements/{id} {
      allow read: if isRegistered();
      allow write: if isOrganizer();
    }

    match /communityPosts/{postId} {
      allow read: if isRegistered();
      allow create: if isRegistered()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.replyCount == 0
        && request.resource.data.reactionCount == 0;

      // Authors may edit their own text. Anyone may move a counter by one, so
      // replying and reacting work without granting a licence to rewrite the
      // post — which the previous `allow update: if isRegistered()` did.
      allow update: if isOrganizer()
        || (isRegistered() && changed().hasOnly(['replyCount'])
            && stepsByOne('replyCount'))
        || (isRegistered() && changed().hasOnly(['reactionCount'])
            && stepsByOne('reactionCount'))
        || (isRegistered() && resource.data.authorId == request.auth.uid
            && changed().hasOnly(['title', 'body']));

      allow delete: if isOrganizer()
        || (isRegistered() && resource.data.authorId == request.auth.uid);

      match /replies/{id} {
        allow read: if isRegistered();
        allow create: if isRegistered() && request.resource.data.authorId == request.auth.uid;
        allow update: if isRegistered() && resource.data.authorId == request.auth.uid
          && changed().hasOnly(['body']);
        allow delete: if isOrganizer()
          || (isRegistered() && resource.data.authorId == request.auth.uid);
      }

      // One document per reacting user, keyed by uid.
      match /reactions/{uid} {
        allow read: if isRegistered();
        allow create, update: if isSelf(uid) && isRegistered()
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isSelf(uid);
      }
    }

    match /threads/{threadId} {
      function isParticipant() {
        return isRegistered() && request.auth.uid in resource.data.participantIds;
      }

      allow read: if isParticipant();
      allow create: if isRegistered()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      // Participants may not rewrite who is in the thread.
      allow update: if isParticipant()
        && changed().hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'unread']);
      allow delete: if false;

      match /messages/{id} {
        function inThread() {
          return isRegistered() && request.auth.uid in
            get(/databases/$(database)/documents/threads/$(threadId)).data.participantIds;
        }

        allow read: if inThread();
        allow create: if inThread() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
